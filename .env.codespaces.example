APP_ENV=production

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
EMBEDDING_API_KEY=
MODEL=deepseek-v4-flash
BOCHA_API_KEY=

TENANT_ID=default_tenant
USER_ID=demo_user
THREAD_ID=demo_thread
MAX_ITERATIONS=3

ENABLE_MEMORY=true
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false
CHECKPOINTER_BACKEND=postgres

ENABLE_MILVUS=true
MEMORY_TOP_K=6
POSTGRES_DSN=postgresql://root:codespaces_demo_password@postgres:5432/mydb
REDIS_URL=
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory
NO_COLOR=true
WORKSPACE_DIR=/workspace
